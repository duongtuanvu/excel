{
  "name": "kysheet",
  "version": "0.5.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build:local": "tsc --noEmit && vite build --mode local-assets",
    "dev:auth": "wrangler dev --local --https",
    "deploy:auth": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.30.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2",
    "vite": "6.4.4",
    "@vitejs/plugin-react": "4.7.0",
    "@types/node": "22.15.30",
    "wrangler": "4.54.0"
  }
}
